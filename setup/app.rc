// The setup app's icon and file properties. The version comes from the mod's one version string, through CMake.

#include <winver.h>

#include "setup_version.h"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     LSS_VERSION_MAJOR, LSS_VERSION_MINOR, LSS_VERSION_PATCH, 0
PRODUCTVERSION  LSS_VERSION_MAJOR, LSS_VERSION_MINOR, LSS_VERSION_PATCH, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "FF7 Remake Split-Screen Setup"
            VALUE "ProductName",      "LocalSplitScreen"
            VALUE "FileVersion",      LSS_VERSION_TEXT
            VALUE "ProductVersion",   LSS_VERSION_TEXT
            VALUE "InternalName",     "LocalSplitScreenSetup"
            VALUE "OriginalFilename", "LocalSplitScreenSetup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
