{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/checks/comment_style.py"],
            "timeout": 10,
            "statusMessage": "Comment style check on the new text"
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/checks/code_hygiene.py"],
            "timeout": 30,
            "statusMessage": "Code hygiene check on the staged diff"
          },
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/tools/checks/comment_style.py"],
            "timeout": 30,
            "statusMessage": "Comment style check on the staged diff"
          }
        ]
      }
    ]
  }
}
